# Doxygen configuration for the Dynamic Pricing & Discount Rule Engine.
# Run from the project root:   doxygen Doxyfile
# Output: docs/api/html/index.html
# Settings not listed here keep Doxygen's defaults.

#---------------------------------------------------------------- project
PROJECT_NAME           = "Dynamic Pricing & Discount Rule Engine"
PROJECT_BRIEF          = "CS2303 OOP project - pricing rules as objects (C++17)"
OUTPUT_DIRECTORY       = docs/api
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

#---------------------------------------------------------------- what to document
INPUT                  = README.md include src
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */_deps/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
SORT_MEMBER_DOCS       = NO

#---------------------------------------------------------------- warnings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------- output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO

#---------------------------------------------------------------- diagrams
# Inheritance diagrams. With HAVE_DOT = NO Doxygen draws them itself, so no
# extra tools are needed. If Graphviz ("dot") is installed, set HAVE_DOT = YES
# for UML-style graphs that also show collaborations.
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
HAVE_DOT               = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 60

# PlantUML diagrams in docs/*.puml can be embedded with @startuml if
# PLANTUML_JAR_PATH is set to the folder holding plantuml.jar.
PLANTUML_JAR_PATH      =
